#!/usr/bin/env bash
# codex-do: gibt einen Auftrag an Codex und liefert nur das Wesentliche zurueck.
#
#   codex-do <<'EOF'
#   …Auftrag…
#   EOF
#
# Der Auftrag kommt ueber stdin. codex-do setzt CODEX_HOME NICHT: es nutzt
# dieselbe Anmeldung und Konfiguration wie ein normales `codex login` im
# Terminal (Standardort ~/.codex). Waere hier ein eigenes CODEX_HOME
# gesetzt, wuerde Codex unter einem Konto suchen, unter dem nie eingeloggt
# wurde - die CLI sagt selbst: "auth still uses CODEX_HOME". Die
# Hausregeln, die Codex bei jedem Aufruf automatisch liest, stehen deshalb
# ganz regulaer in ~/.codex/AGENTS.md. Nur das volle Rohprotokoll jedes
# Laufs landet in einem eigenen Ordner: ~/.codex-tandem/logs/. Auf stdout
# kommen nur die letzten kurzen Zeilen - Codex' Rohausgabe ist sechsstellig
# gross und wuerde jeden Kontext sprengen.
#
# Stellschrauben:
#   CODEX_SANDBOX   read-only | workspace-write | danger-full-access  (Standard: workspace-write;
#                   read-only genuegt fuer reine Recherche; danger-full-access nur nach
#                   ausdruecklicher Freigabe des Menschen fuer genau diesen Auftrag)
#   CODEX_TAIL      wie viele Zeilen zurueckkommen                    (Standard: 25)
#   CODEX_MODEL     Modell ueberschreiben                             (Standard: aus der Config)
#   CODEX_IMAGES    Leerzeichengetrennte Bildpfade als Referenzbilder

set -uo pipefail

LOG_DIR="$HOME/.codex-tandem/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/$(date +%Y%m%d-%H%M%S)-$$.log"

# Die Abschlussantwort holen wir ueber die stabile Codex-Option
# --output-last-message statt sie aus dem Transkript herauszuraten.
ANTWORT_DATEI="$(mktemp "${TMPDIR:-/tmp}/codex-do-antwort.XXXXXX")"
trap 'rm -f "$ANTWORT_DATEI"' EXIT

args=(exec -s "${CODEX_SANDBOX:-workspace-write}" --skip-git-repo-check -o "$ANTWORT_DATEI")
[ -n "${CODEX_MODEL:-}" ] && args+=(-m "$CODEX_MODEL")
if [ -n "${CODEX_IMAGES:-}" ]; then
  for img in $CODEX_IMAGES; do
    [ -f "$img" ] || { echo "codex-do: Referenzbild fehlt: $img" >&2; exit 2; }
    args+=(-i "$img")
  done
fi
args+=(-)

codex "${args[@]}" > "$LOG" 2>&1
status=$?

ANTWORT=""
[ -s "$ANTWORT_DATEI" ] && ANTWORT="$(cat "$ANTWORT_DATEI")"

# Nur Abschlussantwort, Exitcode und Protokollpfad kommen zurueck. Der
# Tokenverbrauch bleibt bewusst aussen vor (Textregel: keine Token-Zahlen) -
# wer ihn braucht, fragt gezielt danach ("Zeig mir den Verbrauch.") statt
# ihn bei jedem Aufruf mitgeliefert zu bekommen.
if [ -n "$ANTWORT" ]; then
  echo "$ANTWORT" | cut -c1-300 | tail -"${CODEX_TAIL:-25}"
  echo "--- codex-do: exit $status · $LOG"
else
  echo "--- codex-do: keine Antwort, exit $status. Letzte Zeilen:"
  awk 'length($0) < 400' "$LOG" \
    | grep -vE '^\s*$' | tail -15 | cut -c1-300
  echo "--- vollstaendiges Protokoll: $LOG"
fi
exit $status
