#!/usr/bin/env bash
# codex-do: gibt einen Auftrag an Codex und liefert nur das Wesentliche zurueck.
#
#   codex-do <<'EOF'
#   …Auftrag…
#   EOF
#
# Der Auftrag kommt ueber stdin. Das volle Transkript landet in
# ~/.codex-tandem/logs/, auf stdout kommen nur die letzten kurzen Zeilen -
# Codex' Rohausgabe ist sechsstellig gross und wuerde jeden Kontext sprengen.
#
# Stellschrauben:
#   CODEX_SANDBOX   read-only | workspace-write | danger-full-access  (Standard: danger-full-access)
#   CODEX_TAIL      wie viele Zeilen zurueckkommen                    (Standard: 25)
#   CODEX_MODEL     Modell ueberschreiben                             (Standard: aus der Config)
#   CODEX_IMAGES    Leerzeichengetrennte Bildpfade als Referenzbilder

set -uo pipefail

LOG_DIR="$HOME/.codex-tandem/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/$(date +%Y%m%d-%H%M%S)-$$.log"

args=(exec -s "${CODEX_SANDBOX:-danger-full-access}" --skip-git-repo-check)
[ -n "${CODEX_MODEL:-}" ] && args+=(-m "$CODEX_MODEL")
if [ -n "${CODEX_IMAGES:-}" ]; then
  for img in $CODEX_IMAGES; do
    [ -f "$img" ] || { echo "codex-do: Referenzbild fehlt: $img" >&2; exit 2; }
    args+=(-i "$img")
  done
fi
args+=(-)

CODEX_HOME="$HOME/.codex-tandem" codex "${args[@]}" > "$LOG" 2>&1
status=$?

# Codex' Transkript wiederholt den ganzen Auftrag und jeden Werkzeugaufruf.
# Interessant ist nur, was nach der Zeile "tokens used" steht - das ist die
# abschliessende Antwort. Fehlt sie, ist etwas schiefgegangen: dann die
# letzten lesbaren Zeilen zeigen, damit der Grund sichtbar wird.
tokens=$(awk '/^tokens used$/{getline t} END{print t}' "$LOG")

if [ -n "$tokens" ]; then
  awk '/^tokens used$/{f=1; getline; next} f' "$LOG" \
    | cut -c1-300 | tail -"${CODEX_TAIL:-25}"
  echo "--- codex-do: $tokens Tokens · exit $status · $LOG"
else
  echo "--- codex-do: keine Antwort, exit $status. Letzte Zeilen:"
  awk 'length($0) < 400' "$LOG" \
    | grep -vE '^\s*$' | tail -15 | cut -c1-300
  echo "--- vollstaendiges Protokoll: $LOG"
fi
exit $status
